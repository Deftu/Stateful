# Kotlin and Gradle scripts have nothing equivalent to rustfmt built in. This pins what the
# repo already does consistently so an editor cannot quietly drift from it.
# `.gitattributes` pins line endings at the git layer; this pins them at the editor layer.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[{gradlew,gradlew.bat,gradle/wrapper/*}]
# Generated by the Gradle wrapper task. Do not reformat by hand.
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
